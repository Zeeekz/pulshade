<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.pulshade.ios.announcements</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PULSHADE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.pulshade.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pulshade</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>onion</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan codes to link your devices, add friends and verify them, and take photos and videos for stories. Frames are never saved.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock PULSHADE with Face ID.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Built by Zeekz</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Reach a PULSHADE relay running on your own network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record voice notes, videos and make calls. Audio is encrypted before it leaves your phone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save pictures from your chats to Photos. Pulshade only adds to your library and never reads it.</string>
	<key>PulshadeAdminKey</key>
	<string>$(PULSHADE_ADMIN_KEY)</string>
	<key>PulshadePetKey</key>
	<string>$(PULSHADE_PET_KEY)</string>
	<key>PulshadeRelay</key>
	<string>$(PULSHADE_RELAY)</string>
	<key>PulshadeRelayDirect</key>
	<string>$(PULSHADE_RELAY_DIRECT)</string>
	<key>PulshadeRelayPin</key>
	<string>$(PULSHADE_RELAY_PIN)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
