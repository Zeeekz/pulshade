#!/usr/bin/env bash
# pulshade-server: runs the Pulshade relay on this server. Put here by install.sh; `pulshade-server help` lists it all.
# Handle and account actions go to the relay with its admin token, which only root can read. Nothing here can read
# anyone's messages.
set -euo pipefail

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

app=/opt/pulshade
data=/var/lib/pulshade
keys=/etc/pulshade
backups=/var/backups/pulshade
relay_url=http://127.0.0.1:7878

bold=$'\e[1m'; dim=$'\e[2m'; green=$'\e[32m'; red=$'\e[31m'; reset=$'\e[0m'
ok()   { printf '%s✓%s %s\n' "$green" "$reset" "$*"; }
fail() { printf '%s✗%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }

usage() {
  cat <<HELP
${bold}pulshade-server${reset}: run the Pulshade relay on this server.

${bold}Relay${reset}
  start              Start it. It also starts by itself whenever the server does.
  stop               Stop it. Waiting messages are kept, sealed, for the next start.
  restart            Stop and start it.
  status             Whether it's running and its onion address.
  logs               Follow its log.
  update             Rebuild from the latest source and restart.

${bold}Handles & accounts${reset}
  stats              Counts: handles, waiting messages, bans, uptime.
  handles            Every public handle and its name.
  lookup @name       One handle: owner, bans, reserved.
  remove @name       Take a listing down. The name stays held for its owner for 3 months.
  free @name         Let anyone claim a held name now.
  give @name KEY     Take the name off whoever has it; only that account key may claim it for 3 months.
  ban @name          Take it down and stop the name ever being used again.
  unban @name
  ban-account @name  Ban the account behind a handle (or pass its public key). All its handles go.
  unban-account KEY
  reserve @name      Only your creator account may claim it.
  unreserve @name
  lists              Banned handles, banned accounts and reserved names.

${bold}For the Pulshade Admin app${reset}
  json ACTION [ARG]  Any relay admin action, its argument base64-encoded; prints the relay's JSON.
  fetch KEY          What's waiting in a mailbox (its receive key in hex), as JSON.
  ack KEY ID...      Drop envelopes from that mailbox once they're read.

${bold}Moderators${reset}
  mod-add NAME KEY   Let a moderator in with their SSH public key (ssh-ed25519 only). They can read reports and
                     take down or ban handles, and nothing else.
  mod-remove NAME    Cut a moderator off at once.
  mod-list           Who has access.
  mod-log [N]        What moderators did, last N lines (default 50).
  mod-reports KEY    The reports mailbox's receive key (hex), kept here so moderators never hold it.
  cases-get          The team's shared report list, sealed (for the Pulshade Admin app).
  cases-put ETAG     Replace it, from stdin, if it hasn't changed since ETAG.
  cases-reset        Start the shared list again (the old one is kept beside it).

${bold}Backups${reset}
  backup             Copy the handle list, moderation and onion keys, sealed, to $backups.
HELP
}

status() {
  if systemctl is-active --quiet pulshade-relay; then ok "Running"; else printf '%s✗%s Not running\n' "$red" "$reset"; fi
  if curl -sf -m 3 "$relay_url/v1/health" >/dev/null; then ok "Answering"; else printf '%s✗%s Not answering\n' "$red" "$reset"; fi
  [[ -s "$data/pulshade-onion/hostname" ]] && ok "Onion address http://$(cat "$data/pulshade-onion/hostname")"
  printf '%sAfter a start it takes a few minutes to be reachable over Tor.%s\n' "$dim" "$reset"
}

# One operator action on the relay, with the token only root can read. Prints the relay's JSON answer.
admin_raw() {
  local action="$1" arg="${2:-}" body out code
  [[ -f "$data/admin.token" ]] || fail "No admin token yet. Start the relay once first: pulshade-server start"
  body=$(python3 -c 'import json,sys; print(json.dumps({"action": sys.argv[1], "arg": sys.argv[2]}))' "$action" "$arg")
  out=$(curl -s -m 10 -w '\n%{http_code}' -X POST "$relay_url/v1/admin" \
        -H 'Content-Type: application/json' -H @<(printf 'x-pulshade-admin-token: %s\n' "$(<"$data/admin.token")") -d "$body") \
    || fail "Can't reach the relay. Is it running? Try: pulshade-server status"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  [[ "$code" == 2* ]] || fail "${out:-Refused ($code)}"
  printf '%s\n' "$out"
}

# The same, indented.
admin() {
  admin_raw "$@" | python3 -m json.tool
}

# For the Pulshade Admin app: an action whose argument comes base64-encoded, so JSON survives SSH's quoting.
admin_json() {
  local action="$1" arg=""
  [[ "$action" =~ ^[a-z-]+$ ]] || fail "Which action?"
  [[ -n "${2:-}" ]] && { arg=$(printf '%s' "$2" | base64 -d 2>/dev/null) || fail "The argument isn't base64"; }
  admin_raw "$action" "$arg"
}

# For the Pulshade Admin app: what's waiting in its reports mailbox, and letting go of what it has read. The
# mailbox key is the app's; the relay only ever sees sealed reports. The key goes to curl on standard input, not
# as an argument, so it never shows in the list of running programs.
mailbox() {
  local cmd="$1" key="${2:-}"
  [[ "$key" =~ ^[0-9a-f]{64}$ ]] || fail "That isn't a mailbox key"
  if [[ "$cmd" == fetch ]]; then
    printf '{"keys":["%s"],"wait":0}' "$key" \
      | curl -sf -m 10 -X POST "$relay_url/v1/fetch" -H 'Content-Type: application/json' -d @- \
      || fail "Can't reach the relay"
    printf '\n'
  else
    shift 2
    local ids; ids=$(IFS=,; printf '%s' "$*")
    [[ "$ids" =~ ^[0-9,]+$ ]] || fail "Which envelopes?"
    printf '{"acks":[{"key":"%s","ids":[%s]}]}' "$key" "$ids" \
      | curl -sf -m 10 -X POST "$relay_url/v1/ack" -H 'Content-Type: application/json' -d @- >/dev/null \
      || fail "Can't reach the relay"
    ok "Done"
  fi
}

# Moderators come in over SSH as one locked account, and each key is forced to run pulshade-mod-gate for its own
# name, so they never get a shell. The gate decides what they may do; see it for the list.
mod_user=pulshade-mod
mod_home=/var/lib/pulshade-mod
mod_keys="$mod_home/.ssh/authorized_keys"

mod_valid_name() {
  [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,23}$ ]] || fail "A moderator's name is lowercase letters, numbers and dashes, up to 24"
  # The gate logs the operator's own requests as "owner", so no moderator may share it.
  [[ "$1" != owner ]] || fail "That name is taken"
}

mod_setup() {
  [[ -x /usr/local/bin/pulshade-mod-gate ]] || fail "The moderator gate isn't installed. Update the server first: pulshade-server update"
  id "$mod_user" >/dev/null 2>&1 || useradd --system --home-dir "$mod_home" --shell /bin/bash "$mod_user"
  # `*` locks the password but still allows a key.
  usermod -p '*' "$mod_user"
  # Owned by root, so the moderator account can't change what its own keys may do.
  install -d -m 755 -o root -g root "$mod_home" "$mod_home/.ssh"
  [[ -f "$mod_keys" ]] || install -m 644 -o root -g root /dev/null "$mod_keys"
  printf 'Defaults:%s env_reset, secure_path="/usr/sbin:/usr/bin:/sbin:/bin"\n%s ALL=(root) NOPASSWD: /usr/local/bin/pulshade-mod-gate *\n' \
    "$mod_user" "$mod_user" > /etc/sudoers.d/pulshade-mod.new
  chmod 440 /etc/sudoers.d/pulshade-mod.new
  visudo -cf /etc/sudoers.d/pulshade-mod.new >/dev/null || { rm -f /etc/sudoers.d/pulshade-mod.new; fail "Couldn't set up sudo for moderators"; }
  mv /etc/sudoers.d/pulshade-mod.new /etc/sudoers.d/pulshade-mod
}

mod_add() {
  local name="${1:-}" key="${2:-}"
  mod_valid_name "$name"
  [[ "$key" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+=*(\ [^[:cntrl:]]*)?$ ]] || fail "That isn't an ssh-ed25519 public key"
  mod_setup
  grep -q "# mod:$name\$" "$mod_keys" 2>/dev/null && fail "There's already a moderator called $name. Remove them first."
  local keytype keydata; read -r keytype keydata _ <<<"$key"
  printf 'command="sudo /usr/local/bin/pulshade-mod-gate %s \\"$SSH_ORIGINAL_COMMAND\\"",restrict %s %s # mod:%s\n' \
    "$name" "$keytype" "$keydata" "$name" >> "$mod_keys"
  ok "$name can now read reports and take down or ban handles"
}

mod_remove() {
  local name="${1:-}"
  mod_valid_name "$name"
  grep -q "# mod:$name\$" "$mod_keys" 2>/dev/null || fail "No moderator called $name"
  grep -v "# mod:$name\$" "$mod_keys" > "$mod_keys.new" || true
  mv "$mod_keys.new" "$mod_keys"
  chmod 644 "$mod_keys"
  ok "$name is cut off"
}

mod_list() {
  [[ -s "$mod_keys" ]] || { printf 'No moderators\n'; return; }
  sed -n 's/.* # mod:\(.*\)$/\1/p' "$mod_keys"
}

mod_log() {
  local n="${1:-50}"
  [[ "$n" =~ ^[0-9]{1,4}$ ]] || fail "How many lines?"
  [[ -f "$data/mod/log" ]] && tail -n "$n" "$data/mod/log" || printf 'Nothing logged yet\n'
}

mod_reports() {
  [[ "${1:-}" =~ ^[0-9a-f]{64}$ ]] || fail "That isn't a mailbox key"
  install -m 600 /dev/null "$keys/mod-reports.key"
  printf '%s' "$1" > "$keys/mod-reports.key"
  ok "Moderators can read reports"
}

backup() {
  local dest; dest="$backups/$(date +%Y-%m-%d_%H-%M-%S)"
  install -d -m 700 "$backups" "$dest"
  for f in pulshade-directory.json pulshade-moderation.json pulshade-held.json pulshade-collectibles.json pulshade-giveaways.json pulshade-handle-history.json; do
    [[ -f "$data/$f" ]] && cp "$data/$f" "$dest/"
  done
  # Sealed with the storage key, so a copy of the backups alone can't take over the onion address.
  if [[ -d "$data/pulshade-onion/state" ]]; then
    tar -C "$data/pulshade-onion" -cf - state \
      | (cd "$data" && PULSHADE_STORAGE_KEY_FILE="$keys/storage.key" "$app/bin/pulshade-relay" seal) \
      > "$dest/pulshade-onion-state.sealed" || fail "Couldn't seal the onion keys"
  fi
  chmod 600 "$dest"/* 2>/dev/null || true
  ok "Backed up to $dest. Without $keys/storage.key it can't be opened, so keep a copy of that somewhere safe too."
}

update() {
  local src="$app/src"
  [[ -d "$src/.git" ]] && git -C "$src" pull -q --ff-only
  "$src/scripts/server/install.sh" --no-firewall
}

case "${1:-help}" in
  start|stop|restart) systemctl "$1" pulshade-relay; [[ "$1" == stop ]] && ok "Stopped" || status ;;
  status) status ;;
  logs) journalctl -u pulshade-relay -f -n 50 ;;
  update) update ;;
  stats|handles|lists) admin "$1" ;;
  lookup|remove|free|reserve|unreserve) [[ -n "${2:-}" ]] || fail "Which handle?"; admin "$1" "$2" ;;
  ban) [[ -n "${2:-}" ]] || fail "Which handle?"; admin ban-handle "$2" ;;
  unban) [[ -n "${2:-}" ]] || fail "Which handle?"; admin unban-handle "$2" ;;
  ban-account|unban-account) [[ -n "${2:-}" ]] || fail "Which account?"; admin "$1" "$2" ;;
  give) [[ -n "${2:-}" && -n "${3:-}" ]] || fail "Give the handle and the account's key"; admin give "$2 $3" ;;
  backup) backup ;;
  mod-add) mod_add "${2:-}" "${3:-}" ;;
  mod-remove) mod_remove "${2:-}" ;;
  mod-list) mod_list ;;
  mod-log) mod_log "${2:-}" ;;
  mod-reports) mod_reports "${2:-}" ;;
  cases-get|cases-put|cases-reset) exec /usr/local/bin/pulshade-mod-gate owner "$*" ;;
  json) [[ -n "${2:-}" ]] || fail "Which action?"; admin_json "$2" "${3:-}" ;;
  fetch|ack) mailbox "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
